# AI Field — environment contract. Copy to `.env.local` and fill in.
# `.env.local` is gitignored; never commit real keys.

# --- Gemini (server-side only; never exposed to the browser) ---
# Get one at https://aistudio.google.com → "API keys".
GEMINI_API_KEY=
# Model id. Default per SPEC. Override to pin a version.
GEMINI_MODEL=gemini-3.7-flash

# --- Supabase ---
# From your project's Settings → API. Use the NEW key names
# (publishable / secret), not the legacy anon / service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key is server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
