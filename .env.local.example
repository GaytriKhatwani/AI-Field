# AI Field — environment contract. Copy to `.env.local` and fill in.
# `.env.local` is gitignored; never commit real keys.

# --- Anthropic Claude (server-side only; never exposed to the browser) ---
# The single LLM provider (isolated in lib/ai/provider.ts). Backs both the
# workbench tool and the judge, same model, different system prompts + effort.
# Get a key at https://console.anthropic.com → API keys (pay-as-you-go; separate
# from a Claude Pro subscription).
ANTHROPIC_API_KEY=
# Model id. Default claude-sonnet-5. Change here to swap models later.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Supabase ---
# From your project's Settings → API. Use the NEW key names
# (publishable / secret), not the legacy anon / service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key is server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Mixpanel (client-side product analytics; optional) ---
# Project token from Mixpanel → Settings → Project Settings. Client-side only —
# the whole analytics layer is a SAFE NO-OP when this is unset, so leaving it
# blank does not affect the app. Prefer a SEPARATE dev project token locally so
# implementation traffic doesn't pollute the real tester cohort.
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Optional: data-residency host (e.g. https://api-eu.mixpanel.com). Leave blank
# to use Mixpanel's default; set once you know the project's residency.
NEXT_PUBLIC_MIXPANEL_API_HOST=
# Optional: stamped onto every event as app_version (defaults to 0.1.0).
NEXT_PUBLIC_APP_VERSION=
